# dependencies
node_modules/
.pnpm-store/

# build output
.next/
out/
dist/
build/

# local pg backups (scripts/backup/backup.sh)
backups/

# turbo
.turbo/

# generated types (produced by `pnpm gen:types`)
packages/types/src/generated/openapi.ts

# env
.env
.env.*
!.env.example

# secrets: only the SOPS-encrypted file and the template may be committed
secrets/*
!secrets/*.sops.env
!secrets/staging.env.example

# age PRIVATE keys, wherever they land. `secrets/*` above only covers one
# directory, so a keypair generated outside the repo (the runbook says to
# generate it offline, so it usually is) stayed committable at the repo root,
# in backend/, in docs/ - anywhere. Verified: `git check-ignore` said NOT
# IGNORED for all three before this line. gitleaks would catch the CONTENT in
# CI, but only after it had been committed and pushed; this stops the file.
*.agekey
*.age.key

# staging deploy state (written on the VPS by scripts/deploy/staging_deploy.sh)
.staging-deployed

# lighthouse CI reports
.lhci/
.lighthouseci/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editors / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# testing / coverage
coverage/

# misc
*.tsbuildinfo

# python (backend)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# playwright (D09 e2e)
test-results/
playwright-report/
