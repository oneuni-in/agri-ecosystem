# Sample env for local dev — copy relevant lines into .env.local
# (gitignored; see .env.local for the other NEXT_PUBLIC_ vars already in use).

# Business Console origin (apps/web-agri, D16 claim/create flow). Task 11's
# "List your dairy business" CTA links cross-origin to
# `${NEXT_PUBLIC_CONSOLE_URL}/business/listings` — a plain <a href>, never the
# locale-aware Link from @/i18n/navigation. NEXT_PUBLIC_ is required because
# the header renders this client-side too (HeaderLocation sits beside it).
# Dev default matches web-agri's `pnpm dev --port 3002`.
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3002
