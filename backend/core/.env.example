# Copy to .env for local overrides. Never put real secrets in this file.
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=
REDIS_URL=
MEILISEARCH_URL=
MEILISEARCH_MASTER_KEY=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# D28 web push (VAPID). Both keys empty = mock driver (push stays dark).
# Generate with docs/runbooks/web-push.md; the private key is a real secret,
# so keep it in .env / sops only, NEVER here. Sends are additionally gated by
# the notify.push_enabled DB flag.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@agri.in
