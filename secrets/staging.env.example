# Template for secrets/staging.env — the SINGLE env file every staging
# service reads (docker-compose.staging.yml env_file). NEVER commit real
# values in plaintext: fill a copy, encrypt it as secrets/staging.sops.env
# (see docs/runbooks/secrets.md), delete the plaintext.
#
# The deploy script decrypts staging.sops.env -> staging.env on the VPS for
# the duration of `compose up` and deletes it afterwards.

APP_ENV=prod
LOG_LEVEL=INFO

# postgres (service + API must agree).
#
# Two identities, deliberately not the same account. The API connects as
# app_rt, which migration 0013 creates inside the database with DML and no
# DDL; alembic connects as the database OWNER (POSTGRES_USER). Pointing
# DATABASE_URL at the owner would hand the running API the ability to rewrite
# its own schema, which is the whole reason the split exists.
#
# OWNER ACTION: 0013 creates app_rt with the password 'app_rt', which is
# published in this repository. Rotate it once per environment before first
# boot and put the new value in DATABASE_URL below:
#   ALTER ROLE app_rt PASSWORD '<the value you put in DATABASE_URL>';
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agri
DATABASE_URL=postgresql+asyncpg://app_rt:CHANGE_ME@postgres:5432/agri
DATABASE_ADMIN_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@postgres:5432/agri

REDIS_URL=redis://redis:6379/0

# meilisearch (service + API must agree)
MEILI_MASTER_KEY=CHANGE_ME
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME

# minio (service + API must agree)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=agri-media

# --- application secrets ------------------------------------------------
# Every one of these has a working default in settings.py so a fresh clone
# runs unconfigured, and every one of those defaults is published in this
# repository. shared/startup_checks.py refuses to start with APP_ENV=prod
# while any of them is still in place, so leaving a line out here surfaces as
# a boot failure naming the variable - not as a silent weak deployment.
#
# Generate each one separately (never reuse a value across two of them):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# OTP_PEPPER is the sharp one: it keys the HMAC over every OTP, and it is the
# only reason a stolen otp table is not brute-forceable across the 10^6 code
# space. Rotating it invalidates OTPs that are already in flight, which costs
# one retry per affected user - do it during a quiet window, not at peak.
OTP_PEPPER=CHANGE_ME
VIEW_BEACON_SECRET=CHANGE_ME
ADS_BEACON_SECRET=CHANGE_ME

# RS256 private key for D08 tokens. get_signing_key() already refuses to boot
# prod without it: an ephemeral key would be regenerated on every restart and
# silently invalidate every live session.
#   openssl genrsa 2048
# Store the PEM with literal \n escapes, or quote the multi-line value.
OAUTH_JWT_PRIVATE_KEY_PEM=CHANGE_ME

# data.gov.in (A-U2 W2 — Agmarknet mandi prices).
# OWNER ACTION: register a free account at https://data.gov.in and paste
# the key here. The public sample key that appears in data.gov.in's docs
# is shared and throttled — measured 2026-08-16 it returns 429 within a
# handful of requests, which is not enough to walk one day of prices at
# the API's 10-rows-per-request ceiling. Without a key the ingest refuses
# to call rather than issue a keyless request.
DATA_GOV_API_KEY=CHANGE_ME

# ── web session signing (all five Next.js apps) ─────────────────────────
# Runtime, server-side only - never NEXT_PUBLIC, never a build arg, never a
# GitHub Actions secret (CI deliberately boots without it; AG-A10 asserts
# the guest home still renders). auth-client THROWS at boot in production
# when this is missing, and without it every authed page 500s while public
# pages look perfectly healthy - which is why it is so easy to miss.
# Generate:  openssl rand -base64 48
AUTH_SESSION_SECRET=CHANGE_ME

# NOT here, deliberately: the auth-client runtime origins (APP_ORIGIN,
# ID_PUBLIC_ORIGIN, API_BASE_URL, and the expected issuer - see
# packages/auth-client/README.md's domain map). APP_ORIGIN differs PER APP,
# and a shared env file would hand every service the same value; they belong
# as per-service `environment:` entries in the compose once the real domains
# exist. Until then every app falls back to its localhost default, which is
# correct for a single-host staging behind a reverse proxy only if that
# proxy rewrites - decide at DNS time, do not guess here.
