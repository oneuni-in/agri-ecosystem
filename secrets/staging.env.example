# Template for secrets/staging.env — the SINGLE env file every staging
# service reads (docker-compose.staging.yml env_file). NEVER commit real
# values in plaintext: fill a copy, encrypt it as secrets/staging.sops.env
# (see docs/runbooks/secrets.md), delete the plaintext.
#
# The deploy script decrypts staging.sops.env -> staging.env on the VPS for
# the duration of `compose up` and deletes it afterwards.

APP_ENV=prod
LOG_LEVEL=INFO

# postgres (service + API must agree)
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agri
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@postgres:5432/agri

REDIS_URL=redis://redis:6379/0

# meilisearch (service + API must agree)
MEILI_MASTER_KEY=CHANGE_ME
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=CHANGE_ME

# minio (service + API must agree)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=agri-media

# data.gov.in (A-U2 W2 — Agmarknet mandi prices).
# OWNER ACTION: register a free account at https://data.gov.in and paste
# the key here. The public sample key that appears in data.gov.in's docs
# is shared and throttled — measured 2026-08-16 it returns 429 within a
# handful of requests, which is not enough to walk one day of prices at
# the API's 10-rows-per-request ceiling. Without a key the ingest refuses
# to call rather than issue a keyless request.
DATA_GOV_API_KEY=CHANGE_ME
